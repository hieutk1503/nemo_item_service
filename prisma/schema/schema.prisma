generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model Game {
  id                   Int                      @id @default(autoincrement())
  code                 String                   @unique @db.VarChar(50)
  name                 String                   @db.VarChar(100)
  baseUrl              String                   @db.VarChar(255)
  isActive             Boolean                  @default(true)
  leaderboardConfigs   LeaderboardPrizeConfig[]
  leaderboardSnapshots LeaderboardSnapshot[]
  luckyboxConfigs      LuckyboxPrizeConfig[]
  plans                Plan[]
  rewardHistories      RewardHistory[]
  scoreHistories       ScoreHistory[]
  transactions         Transaction[]

  @@map("games")
}

model User {
  msisdn               String                @id @db.VarChar(20)
  username             String?               @db.VarChar(100)
  fullName             String?               @db.VarChar(100)
  lang                 String                @default("en") @db.VarChar(10)
  lastLogin            DateTime              @default(now())
  createdAt            DateTime              @default(now())
  leaderboardSnapshots LeaderboardSnapshot[]
  rewardHistories      RewardHistory[]
  scoreHistories       ScoreHistory[]
  subscriptions        Subscription[]
  transactions         Transaction[]
  inventories          Inventory[]

  @@map("users")
}

model Plan {
  id            Int            @id @default(autoincrement())
  gameId        Int
  name          String         @db.VarChar(100)
  price         Decimal        @db.Decimal(10, 2)
  duration_days Int
  packageCode   String         @db.VarChar(50)
  description   String?        @db.Text
  benefits      PlanBenefit[]
  game          Game           @relation(fields: [gameId], references: [id])
  subscriptions Subscription[]

  @@index([gameId], map: "plans_gameId_fkey")
  @@map("plans")
}

model PlanBenefit {
  id             Int    @id @default(autoincrement())
  planId         Int
  benefit_type   String @db.VarChar(50)
  benefit_ref_id String @db.VarChar(100)
  quantity       Int
  grant_type     String @db.VarChar(50)
  plan           Plan   @relation(fields: [planId], references: [id])

  @@index([planId], map: "plan_benefits_planId_fkey")
  @@map("plan_benefits")
}

model Subscription {
  id        Int       @id @default(autoincrement())
  userId    String    @db.VarChar(20)
  planId    Int
  status    Int       @default(0)
  startDate DateTime  @default(now())
  endDate   DateTime?
  refId     String?   @unique
  plan      Plan      @relation(fields: [planId], references: [id])
  user      User      @relation(fields: [userId], references: [msisdn])

  @@index([planId], map: "subscriptions_planId_fkey")
  @@index([userId], map: "subscriptions_userId_fkey")
  @@map("subscriptions")
}

model Transaction {
  id        Int      @id @default(autoincrement())
  msisdn    String   @db.VarChar(20)
  gameCode  String   @db.VarChar(50)
  action    String
  status    Int
  payload   String?  @db.Text
  createdAt DateTime @default(now())
  amount    Decimal? @db.Decimal(10, 2)
  refId     String?  @unique @db.VarChar(100)
  game      Game     @relation(fields: [gameCode], references: [code])
  user      User     @relation(fields: [msisdn], references: [msisdn])

  @@index([gameCode, createdAt])
  @@index([msisdn], map: "transactions_msisdn_fkey")
  @@map("transactions")
}

model LeaderboardPrizeConfig {
  id         Int        @id @default(autoincrement())
  gameId     String     @map("game_id") @db.VarChar(50)
  rankFrom   Int        @map("rank_from")
  rankTo     Int        @map("rank_to")
  rewardType RewardType @map("reward_type")
  rewardId   String     @map("reward_id") @db.VarChar(30)
  quantity   Int
  isActive   Boolean    @default(true) @map("is_active")
  game       Game       @relation(fields: [gameId], references: [code])

  @@index([gameId, isActive])
  @@map("leaderboard_prize_config")
}

model LeaderboardSnapshot {
  id         Int      @id @default(autoincrement())
  gameId     String   @map("game_id") @db.VarChar(50)
  seasonId   Int      @map("season_id")
  userId     String   @map("user_id") @db.VarChar(20)
  userName   String   @map("user_name") @db.VarChar(50)
  totalScore BigInt   @map("total_score")
  rankScore  Int      @map("rank_score")
  createdAt  DateTime @default(now()) @map("created_at")
  game       Game     @relation(fields: [gameId], references: [code])
  user       User     @relation(fields: [userId], references: [msisdn])

  @@unique([gameId, seasonId, userId])
  @@index([gameId, seasonId, rankScore])
  @@index([userId], map: "leaderboard_snapshot_user_id_fkey")
  @@map("leaderboard_snapshot")
}

model ScoreHistory {
  id         Int      @id @default(autoincrement())
  userId     String   @map("user_id") @db.VarChar(20)
  gameId     String   @map("game_id") @db.VarChar(50)
  seasonId   Int      @map("season_id")
  scorePlus  Int      @map("score_plus")
  totalScore BigInt   @map("total_score")
  createdAt  DateTime @default(now()) @map("created_at")
  game       Game     @relation(fields: [gameId], references: [code])
  user       User     @relation(fields: [userId], references: [msisdn])

  @@index([userId, gameId])
  @@index([gameId], map: "score_history_game_id_fkey")
  @@map("score_history")
}

model LuckyboxPrizeConfig {
  id         Int        @id @default(autoincrement())
  gameId     String     @map("game_id") @db.VarChar(50)
  rewardType RewardType @map("reward_type")
  rewardId   String     @map("reward_id") @db.VarChar(30)
  quantity   Int
  weight     Float
  isActive   Boolean    @default(true) @map("is_active")
  game       Game       @relation(fields: [gameId], references: [code])

  @@index([gameId, isActive])
  @@map("luckybox_prize_config")
}

model RewardHistory {
  id         Int        @id @default(autoincrement())
  userId     String     @map("user_id") @db.VarChar(20)
  gameId     String     @map("game_id") @db.VarChar(50)
  sourceType SourceType @map("source_type")
  sourceId   String?    @map("source_id") @db.VarChar(30)
  rewardType RewardType @map("reward_type")
  rewardId   String     @map("reward_id") @db.VarChar(30)
  quantity   Int
  createdAt  DateTime   @default(now()) @map("created_at")
  game       Game       @relation(fields: [gameId], references: [code])
  user       User       @relation(fields: [userId], references: [msisdn])

  @@index([userId, gameId])
  @@index([gameId], map: "reward_history_game_id_fkey")
  @@map("reward_history")
}

model Item {
  category_id Int
  created_at  DateTime    @default(now())
  description String?     @db.Text
  icon_url    String?
  item_code   String      @unique
  item_id     Int         @id @default(autoincrement())
  item_name   String
  max_stack   Int         @default(999)
  metadata    Json?
  price       Decimal     @db.Decimal(10, 2)
  inventories Inventory[]
  category    Category    @relation(fields: [category_id], references: [category_id])

  @@index([category_id], map: "items_category_id_fkey")
  @@map("items")
}

model Category {
  category_code String @unique
  category_id   Int    @id @default(autoincrement())
  category_name String
  sort_order    Int    @default(0)
  items         Item[]

  @@map("categories")
}

model Inventory {
  inventory_id      Int       @id @default(autoincrement())
  user_id           String
  item_type         String
  item_reference_id Int
  quantity          Int       @default(1)
  current_level     Int       @default(1)
  is_equipped       Boolean   @default(false)
  custom_data       Json?
  expires_at        DateTime?
  acquired_at       DateTime  @default(now())
  game_id           Int
  user              User     @relation(fields: [user_id], references: [msisdn])
  item              Item     @relation(fields: [item_reference_id], references: [item_id])

  @@unique([user_id, game_id, item_reference_id])
  @@index([item_reference_id], map: "inventory_item_reference_id_fkey")
  @@map("inventory")
}

model order_log {
  id         Int      @id @default(autoincrement())
  order_id   Int
  game_id    Int
  old_status String?
  new_status String?
  created_at DateTime @default(now())
}

model orders {
  id             Int                    @id @default(autoincrement())
  game_id        Int
  user_id        String                 @db.VarChar(20)
  total_amount   Decimal                @db.Decimal(19, 4)
  status         orders_status          @default(PENDING)
  payment_method orders_payment_method?
  created_at     DateTime               @default(now())
  orders_item    orders_item[]
}

model orders_item {
  id          Int     @id @default(autoincrement())
  order_id    Int
  product_id  Int
  quantity    Int
  unit_price  Decimal @db.Decimal(19, 4)
  total_price Decimal @db.Decimal(19, 4)
  orders      orders  @relation(fields: [order_id], references: [id])

  @@index([order_id], map: "orders_item_order_id_fkey")
}

model transaction_log {
  id         Int                    @id @default(autoincrement())
  order_id   Int
  game_id    Int
  amount     Decimal                @db.Decimal(19, 4)
  status     transaction_log_status
  created_at DateTime               @default(now())
}

model Admin {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  fullName  String?
  role      String   @default("STAFF")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime
}

enum RewardType {
  Items
  Wallet
}

enum SourceType {
  luckybox
  leaderboard
}

enum orders_status {
  PENDING
  SUCCESS
  FAILED
}

enum transaction_log_status {
  INIT
  PROCESSING
  SUCCESS
  FAILED
  REFUNDED
}

enum orders_payment_method {
  VND
  USD
  GEM
  COIN
}
